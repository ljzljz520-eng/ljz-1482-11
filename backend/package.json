{
  "name": "park-studio-backend",
  "private": true,
  "version": "1.0.0",
  "description": "Yunxi Studio - project creation wizard backend (drafts, idempotent project creation, reference material parse queue)",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "worker": "node dist/worker.js",
    "seed": "node dist/seed.js",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch src/index.ts"
  },
  "prisma": {
    "seed": "node dist/seed.js"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "express": "4.21.2",
    "pino": "9.5.0",
    "zod": "3.23.8",
    "prisma": "5.22.0"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "20.11.24",
    "tsx": "4.19.2",
    "typescript": "5.2.2"
  }
}
