{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "emitDeclarationOnly": true,
    "outDir": "./node_modules/.tmp-tsc",
    "tsBuildInfoFile": "./node_modules/.tmp-tsc/.tsbuildinfo"
  },
  "include": [
    "vite.config.ts"
  ]
}
